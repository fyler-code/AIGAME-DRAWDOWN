{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": ["node", "vite/client"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "vite.config.ts",
    "scripts/**/*.ts",
    "src/content/**/*.ts",
    "src/types/**/*.ts",
    "src/constants/**/*.ts",
    "src/engine/**/*.ts",
    "package.json"
  ],
  "exclude": ["src/engine/__tests__/**", "src/content/__tests__/**", "src/store/**"]
}
